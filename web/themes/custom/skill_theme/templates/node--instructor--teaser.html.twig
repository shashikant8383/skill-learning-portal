<div class="instructor-card">

  <div class="instructor-card-image">
    {{ content.field_profile_photo }}
  </div>

  <div class="instructor-card-content">

    <h3 class="instructor-card-name">
      <a href="{{ url }}">
        {{ label }}
      </a>
    </h3>

    <div class="instructor-card-exp">
      Experience: {{ content.field_experience }}
    </div>

  </div>

</div>