<div class="instructor-page">

  <div class="instructor-page-image">
    {{ content.field_profile_photo }}
  </div>

  <div class="instructor-page-content">

    <h1 class="instructor-page-name">
      {{ label }}
    </h1>

    <div class="instructor-page-exp">
      Experience: {{ content.field_experience }}
    </div>

    <div class="instructor-page-bio">
      {{ content.field_bio }}
    </div>

  </div>

</div>